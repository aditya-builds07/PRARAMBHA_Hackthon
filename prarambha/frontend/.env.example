# PRARAMBHA 2.0 — Frontend Environment Example
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to git.

# Base URL for the backend API (Member 2 sets this up)
VITE_API_BASE_URL=http://localhost:3001

# Set to "true" to use the mock simulation service (no backend required)
# Set to "false" or remove when Member 1/2 ship the real API
VITE_USE_MOCK=true
