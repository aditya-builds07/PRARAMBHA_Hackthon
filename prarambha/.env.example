# Copy this file to prarambha/.env for local backend development. Do not commit .env.
PORT=3001
NODE_ENV=development

# Server-only Supabase credentials. Use the project URL and service-role key from
# Supabase Dashboard → Project Settings → API. Never place the service-role key in Vite code.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional external adapters
GOOGLE_MAPS_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Non-secret frontend configuration belongs in frontend/.env.local when needed.
# VITE_API_BASE_URL=http://localhost:3001
# VITE_USE_MOCK=false
